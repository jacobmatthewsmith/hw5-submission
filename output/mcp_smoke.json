{
  "description": "Smoke test of the campus-customs MCP server, called from the vibe coder (Claude Code) through the project .mcp.json connection. Each tool output is copied verbatim from the MCP call and cross-checked against data/campus_customs_new.db with the SQL shown.",
  "mcp_server": "campus-customs (mcp_server/server.py, stdio, configured in .mcp.json)",
  "database": "data/campus_customs_new.db",
  "tested_on": "2026-10-14",
  "tests": [
    {
      "ticket": 101,
      "vibe_coder_prompt": "Ticket 101 links to invoice 501. Use the campus-customs MCP server to check whether that invoice's vendor is blocked from shipping, and report the vendor, its lead time, and any open invoices with days overdue.",
      "tool": "vendor_invoice_blockers",
      "arguments": {
        "invoice_id": 501
      },
      "tool_output": {
        "shop_today": "2026-08-31",
        "vendor": {
          "id": 1,
          "name": "Bulldog Print Co",
          "specialty": "apparel reprint",
          "lead_days": 5
        },
        "open_invoices": [
          {
            "invoice_id": 501,
            "amount": 840,
            "due_date": "2026-08-28",
            "description": "Rush reprint CC-TEE-WHITE S",
            "days_overdue": 3,
            "is_overdue": true
          }
        ],
        "open_total": 840,
        "can_ship": false
      },
      "db_check": {
        "SELECT date_today FROM desk": [
          [
            "2026-08-31"
          ]
        ],
        "SELECT id, name, specialty, lead_days FROM vendors WHERE id = 1": [
          [
            1,
            "Bulldog Print Co",
            "apparel reprint",
            5
          ]
        ],
        "SELECT id, vendor_id, amount, due_date, status, description FROM invoices WHERE vendor_id = 1": [
          [
            501,
            1,
            840.0,
            "2026-08-28",
            "open",
            "Rush reprint CC-TEE-WHITE S"
          ]
        ],
        "matches": true,
        "note": "days_overdue = 2026-08-31 minus 2026-08-28 = 3. can_ship is false because invoice 501 has status 'open'."
      }
    },
    {
      "ticket": 102,
      "vibe_coder_prompt": "Ticket 102 is a rent notice for lease 1. Use the campus-customs MCP server to look up the rent amount, the due date, how many days until it is due, and whether the checking account can cover it.",
      "tool": "lease_rent_schedule",
      "arguments": {
        "lease_id": 1
      },
      "tool_output": {
        "shop_today": "2026-08-31",
        "lease": {
          "id": 1,
          "space_name": "Chapel Street shop",
          "landlord": "Elm City Properties",
          "monthly_rent": 2400,
          "next_due": "2026-09-02",
          "notes": null
        },
        "days_until_due": 2,
        "is_overdue": false,
        "cash_accounts": [
          {
            "name": "checking",
            "balance": 3400,
            "balance_date": "2026-08-31",
            "covers_rent": true,
            "balance_after_rent": 1000
          }
        ]
      },
      "db_check": {
        "SELECT id, space_name, landlord, monthly_rent, next_due, notes FROM leases WHERE id = 1": [
          [
            1,
            "Chapel Street shop",
            "Elm City Properties",
            2400.0,
            "2026-09-02",
            null
          ]
        ],
        "SELECT name, balance, date FROM cash_accounts": [
          [
            "checking",
            3400.0,
            "2026-08-31"
          ]
        ],
        "matches": true,
        "note": "days_until_due = 2026-09-02 minus 2026-08-31 = 2. balance_after_rent = 3400 - 2400 = 1000."
      }
    },
    {
      "ticket": 103,
      "vibe_coder_prompt": "Ticket 103 asks for 20 CC-HOOD-NAVY hoodies in size M with a bulk discount. Use the campus-customs MCP server to check stock by size, the shortfall, the restock cost, and the margin at list price.",
      "tool": "stock_margin_quote",
      "arguments": {
        "sku": "CC-HOOD-NAVY",
        "size": "M",
        "qty": 20
      },
      "tool_output": {
        "sku": "CC-HOOD-NAVY",
        "name": "Basic Hoodie Big Yale",
        "location": "Aisle A",
        "requested": {
          "size": "M",
          "qty": 20
        },
        "stock_by_size": {
          "S": 4,
          "M": 8,
          "L": 14,
          "XL": 6
        },
        "on_hand": 8,
        "shortfall": 12,
        "unit_cost": 22,
        "list_price": 58,
        "restock_cost_for_shortfall": 264,
        "at_list_price": {
          "unit_price": 58,
          "unit_margin": 36,
          "margin_pct": 62.1,
          "order_revenue": 1160,
          "order_margin": 720,
          "below_cost": false
        }
      },
      "db_check": {
        "SELECT sku, name, size, qty, location FROM inventory WHERE sku = 'CC-HOOD-NAVY'": [
          [
            "CC-HOOD-NAVY",
            "Basic Hoodie Big Yale",
            "L",
            14,
            "Aisle A"
          ],
          [
            "CC-HOOD-NAVY",
            "Basic Hoodie Big Yale",
            "M",
            8,
            "Aisle A"
          ],
          [
            "CC-HOOD-NAVY",
            "Basic Hoodie Big Yale",
            "S",
            4,
            "Aisle A"
          ],
          [
            "CC-HOOD-NAVY",
            "Basic Hoodie Big Yale",
            "XL",
            6,
            "Aisle A"
          ]
        ],
        "SELECT sku, unit_cost, list_price FROM pricing WHERE sku = 'CC-HOOD-NAVY'": [
          [
            "CC-HOOD-NAVY",
            22.0,
            58.0
          ]
        ],
        "matches": true,
        "note": "shortfall = 20 - 8 = 12. restock cost = 12 x 22 = 264. unit margin = 58 - 22 = 36 (62.1%). order revenue = 20 x 58 = 1160."
      }
    }
  ]
}