# Campus Customs agent team: environment variables
#
# Copy this file to .env in the project root (hw5/.env) and fill in the value:
#     cp .env.example .env
# The backend also looks for .env up to two folders above the project root, so
# you can keep the real key outside the repo. Never commit a real .env.

# Required. Portkey API key. Every agent calls gpt-6-luna through the Portkey
# gateway (https://api.portkey.ai/v1) with this key; no other model is used.
PORTKEY_API_KEY=your-portkey-api-key-here

# Not needed in .env. CAMPUS_MCP_ROLE is set by the backend itself when it starts
# the MCP server: "agent" for the agents (cannot approve or pay anything) and
# "human" only for the dashboard's Approve/Reject buttons.

# Optional, frontend only. Put this in frontend/.env.local if the backend is not
# at the default address:
#     VITE_API_URL=http://localhost:8000
